{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"codegen": {
			"inputs": ["../crates/rtc-wire/schema/**/*.capnp"],
			"outputs": ["src/generated/**"]
		},
		"build": {
			"dependsOn": ["^build", "codegen"],
			"outputs": ["dist/**"]
		},
		"check": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["codegen"]
		},
		"test": {
			"dependsOn": ["build"],
			"cache": false
		},
		"frontend#test": {
			"dependsOn": ["frontend#codegen"],
			"cache": false
		}
	}
}
