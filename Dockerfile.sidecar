# Multi-arch build: works natively on both amd64 and arm64.
# Build with: docker buildx build --platform linux/amd64,linux/arm64 ...
FROM rust:1-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    libosmesa6-dev \
    cmake \
    pkg-config \
    # libxkbcommon for keymap compilation + compose
    libxkbcommon-dev \
    # capnproto: needed by `x11-web-wire`'s build.rs to codegen
    # Rust bindings from `wire.capnp`.
    capnproto \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ARG CACHE_BUST=0
COPY Cargo.toml Cargo.lock ./
# Set up the x11rb-protocol fork that Cargo.toml's [patch.crates-io]
# redirects to. tools/setup-x11rb-fork.sh clones upstream, applies the
# patches in crates/x11rb-protocol-msb/patches/, and regenerates the
# protocol bindings. Copy only the inputs the script reads, so the
# layer is cached until the script or patches change.
COPY tools/setup-x11rb-fork.sh tools/setup-x11rb-fork.sh
COPY crates/x11rb-protocol-msb/ crates/x11rb-protocol-msb/
RUN bash tools/setup-x11rb-fork.sh
# Copy only the crates the sidecar actually depends on. Crates like
# `backend`, `auth`, `ws-wire`, `rtc-wire`, and `sidecar-macos` are
# workspace members but are NOT transitive dependencies of
# `x11-web-sidecar`, so we stub them out. This keeps the layer cache
# valid when backend-only files change — no sidecar rebuild needed.
COPY crates/sidecar/ crates/sidecar/
COPY crates/x11-server/ crates/x11-server/
COPY crates/protocol/ crates/protocol/
COPY crates/wire/ crates/wire/
COPY crates/pixel-codec/ crates/pixel-codec/
COPY crates/telemetry/ crates/telemetry/
# Stub workspace members the sidecar doesn't depend on so `cargo build`
# can resolve the workspace manifest without them.
RUN for crate in backend auth rtc-wire ws-wire sidecar-macos; do \
      mkdir -p crates/$crate/src; \
      printf '[package]\nname = "x11-web-%s"\nversion = "0.1.0"\nedition = "2021"\n' "$crate" \
        > crates/$crate/Cargo.toml; \
      printf 'fn main() {}\n' > crates/$crate/src/main.rs; \
    done
RUN cargo build --release --bin x11-web-sidecar

# Build Xts (X Test Suite) from source — not available in Debian repos
FROM debian:bookworm-slim AS xts-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates build-essential pkg-config \
    libx11-dev libxt-dev libxext-dev libxi-dev libxtst-dev \
    libxmu-dev libxaw7-dev xutils-dev autoconf automake libtool \
    x11proto-dev libxrender-dev libxfixes-dev libxrandr-dev \
    libxinerama-dev libxcomposite-dev libxdamage-dev \
    xfonts-utils perl x11-utils x11-xserver-utils \
    && rm -rf /var/lib/apt/lists/*
# Clone and build xts from freedesktop.org
RUN git clone --depth 1 https://gitlab.freedesktop.org/xorg/test/xts.git /opt/xts-src
WORKDIR /opt/xts-src
# Configure and build the test suite.
# autoreconf may warn about missing macros for optional subsystems — that is fine.
RUN autoreconf -fi 2>&1; \
    if [ ! -f configure ]; then echo "autoreconf failed to produce configure" >&2; exit 1; fi
RUN ./configure --prefix=/opt/xts 2>&1
# Build and install — some individual test programs may fail (stale tests for
# deprecated features), but the overall build must succeed.
RUN make -j$(nproc) 2>&1; exit 0
RUN make install 2>&1; exit 0
# Verify the install produced something useful
RUN test -d /opt/xts || { echo "XTS install dir missing" >&2; exit 1; }

# Build dbusmenu test helper from source
FROM debian:bookworm-slim AS dbusmenu-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config \
    libdbusmenu-glib-dev libx11-dev libglib2.0-dev \
    && rm -rf /var/lib/apt/lists/*
COPY crates/x11-server/test-tools/dbusmenu-test.c /tmp/
# dbusmenu-test.c uses GDBus (`#include <gio/gio.h>`) plus the
# libdbusmenu-glib-0.4 / x11 headers, but `dbusmenu-glib-0.4.pc`
# doesn't transitively pull in glib's own header path on Debian's
# pkg-config setup — add `gio-2.0` explicitly so the build doesn't
# silently fall through to the `|| touch` fallback. Drop the touch
# fallback: a working binary is required for the dbusmenu e2e test
# and a silently-empty file is harder to debug than a build failure.
RUN gcc -o /usr/local/bin/dbusmenu-test /tmp/dbusmenu-test.c \
    $(pkg-config --cflags --libs dbusmenu-glib-0.4 x11 gio-2.0)

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    strace \
    gdb \
    libosmesa6 \
    libgl1-mesa-dri \
    x11-apps \
    xterm \
    xfonts-base \
    xfonts-75dpi \
    xfonts-100dpi \
    xfonts-scalable \
    vim \
    zenity \
    libgtk2.0-0 \
    dbus \
    dbus-x11 \
    gtk-3-examples \
    qpdfview \
    libdbusmenu-qt5-2 \
    emacs-nox \
    nano \
    x11-utils \
    x11-xserver-utils \
    xinput \
    firefox-esr \
    fonts-dejavu-core \
    fonts-liberation \
    fonts-noto-core \
    libdbus-glib-1-2 \
    procps \
    matchbox-window-manager \
    gimp \
    librsvg2-common \
    adwaita-icon-theme \
    imagemagick \
    xvfb \
    xdotool \
    # X11 protocol tracer — decodes the full client<->server byte
    # stream for input-pipeline debugging (`xtrace -o log cmd...`).
    xtrace \
    gnome-calculator \
    xauth \
    xclip \
    xsel \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    mesa-utils \
    x11-xkb-utils \
    libxt6 libxmu6 libxaw7 libxtst6 \
    # GTK4 app support
    libgtk-4-1 gnome-text-editor \
    # Qt6 app support
    qt6-base-dev libqt6widgets6 \
    # LibreOffice (writer only, keeps image smaller)
    libreoffice-writer-nogui \
    # Fontconfig for TrueType/OpenType font discovery
    fontconfig \
    # Python3 for test scripts and protocol fuzzing
    python3 python3-xlib \
    # SDL2 for game/multimedia testing
    libsdl2-2.0-0 \
    # Qt5 terminal for e2e Qt5 tests
    qterminal \
    # Tcl/Tk for e2e wish tests
    tk \
    # dbusmenu runtime library for test helper
    libdbusmenu-glib4 \
    # Video codecs for Firefox media playback (H.264, VP8/VP9, Opus, etc.)
    ffmpeg \
    libavcodec-extra \
    # PulseAudio daemon + pactl/parec utils for the audio.spec.ts suite.
    # The /etc/pulse/system.pa config below relies on the daemon being
    # present; without these, every audio test conditionally-skips.
    pulseaudio \
    pulseaudio-utils \
    # VLC (cvlc headless) for the audio playback test. Audacity is also
    # exercised by audio.spec.ts but its install footprint is large; the
    # test there already skips gracefully when audacity is absent.
    vlc \
    # C++ toolchain + pkg-config so the qt6 widget compile-and-run test
    # in x11-web.spec.ts can actually build its inline source instead of
    # falling back to GPP_MISSING. qt6-base-dev (above) brings the
    # headers but not the compiler driver.
    g++ \
    pkg-config \
    # Full JDK so apps/java.spec.ts (Java Swing) can compile + run the
    # inline SwingTest.java. default-jdk-headless lacks the AWT/Swing
    # graphical classes Swing needs.
    default-jdk \
    # CJK fonts for XIM CJK input testing
    fonts-noto-cjk \
    # OpenSSL runtime — used by X11 apps (Firefox, etc.) for TLS.
    libssl3 \
    # GLX testing (not available on all architectures; install if present)
    && rm -rf /var/lib/apt/lists/* \
    && apt-get update && apt-get install -y --no-install-recommends glmark2 2>/dev/null; \
       rm -rf /var/lib/apt/lists/*

# Pre-generate fontconfig cache so Firefox startup is fast (CJK fonts are slow to scan)
RUN fc-cache -f -v 2>/dev/null || true

# Create test video and HTML page for local video playback e2e tests.
# Generates a 5-second 320x240 test pattern video with a beep tone.
RUN ffmpeg -y -f lavfi -i "testsrc=duration=5:size=320x240:rate=24" \
    -f lavfi -i "sine=frequency=440:duration=5" \
    -c:v libx264 -preset ultrafast -pix_fmt yuv420p \
    -c:a aac -b:a 64k \
    /opt/test-video.mp4 2>/dev/null || true

# HTML test page for local video playback
RUN mkdir -p /opt/test-content && cat > /opt/test-content/video-test.html <<'HTMLEOF'
<!DOCTYPE html>
<html><head><title>Video Test</title>
<style>body{margin:0;background:#000}video{width:100%;height:100vh}</style>
</head><body>
<video id="v" autoplay muted loop>
  <source src="/test-video.mp4" type="video/mp4">
</video>
<script>
  const v = document.getElementById('v');
  v.play().catch(() => v.muted = true && v.play());
</script>
</body></html>
HTMLEOF
RUN cp /opt/test-video.mp4 /opt/test-content/test-video.mp4 2>/dev/null || true

# Suppress Firefox first-run chrome (welcome tab, privacy-notice tab,
# default-browser nag, whatsnew redirects). Without this every fresh
# profile opens 1-2 extra tabs, which makes "which tab is active"
# non-deterministic for e2e tests that pass a URL on the command line.
RUN mkdir -p /etc/firefox-esr && cat > /etc/firefox-esr/e2e-prefs.js <<'PREFSEOF'
pref("browser.aboutwelcome.enabled", false);
pref("browser.startup.homepage_override.mstone", "ignore");
pref("startup.homepage_welcome_url", "");
pref("startup.homepage_welcome_url.additional", "");
pref("startup.homepage_override_url", "");
pref("datareporting.policy.firstRunURL", "");
pref("datareporting.policy.dataSubmissionEnabled", false);
pref("toolkit.telemetry.reportingpolicy.firstRun", false);
pref("browser.shell.checkDefaultBrowser", false);
pref("app.update.enabled", false);
PREFSEOF

# Input-probe page for the deterministic Firefox input e2e test: the
# page can ONLY change color by receiving real DOM input events, so
# counting exact-color pixels verifies the input pipeline end-to-end
# without golden screenshots (immune to animations/blinking carets).
RUN cat > /opt/test-content/input-probe.html <<'PROBEEOF'
<!DOCTYPE html>
<html><head><title>input probe</title>
<style>
  html,body{margin:0;height:100%;background:#ffffff}
  /* Pure-CSS probe: hover needs no JS and no click — it isolates
     "pointer events reach Gecko at all" from DOM event dispatch. */
  body:hover{background:#0000ff}
</style>
</head><body>
<script>
  addEventListener('pointerdown', () => {
    document.body.style.setProperty('background', '#ff00ff', 'important');
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'g')
      document.body.style.setProperty('background', '#00cc00', 'important');
  });
</script>
</body></html>
PROBEEOF
# Copy Xts test suite from builder
COPY --from=xts-builder /opt/xts /opt/xts
COPY --from=xts-builder /opt/xts-src /opt/xts-src
COPY --from=dbusmenu-builder /usr/local/bin/dbusmenu-test /usr/local/bin/dbusmenu-test
# PulseAudio: run in system mode (as root in container), allow anonymous.
RUN mkdir -p /etc/pulse /run/pulse /var/run/pulse && \
    printf '%s\n' \
      "load-module module-native-protocol-unix auth-anonymous=1" \
      "load-module module-null-sink sink_name=virtual_out sink_properties=device.description=VirtualOutput" \
      "load-module module-null-sink sink_name=virtual_in sink_properties=device.description=VirtualInput" \
      "set-default-sink virtual_out" \
      > /etc/pulse/system.pa && \
    printf '%s\n' \
      "autospawn = no" \
      "default-server = unix:/var/run/pulse/native" \
      > /etc/pulse/client.conf

RUN mkdir -p /tmp/.X11-unix
# Fixed hostname so xterm/vim prompts are deterministic in e2e snapshot tests
RUN echo "x11web" > /etc/hostname
COPY --from=builder /app/target/release/x11-web-sidecar /usr/local/bin/
COPY crates/x11-server/fonts/ /usr/local/share/fonts/bdf/
COPY crates/sidecar/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENV DISPLAY_NUMBER=99
ENV NO_AT_BRIDGE=1
ENV HOSTNAME=x11web
# Force software rendering for Mesa clients in containers without GPU access.
ENV LIBGL_ALWAYS_SOFTWARE=1
ENV RUST_LOG=debug
# PulseAudio: apps connect to the local daemon via default socket.
ENV PULSE_SERVER=unix:/var/run/pulse/native
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
