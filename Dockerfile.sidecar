FROM rust:1-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
RUN cargo build --release --bin x11-web-sidecar

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    x11-apps \
    xterm \
    xfonts-base \
    vim \
    \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /tmp/.X11-unix
COPY --from=builder /app/target/release/x11-web-sidecar /usr/local/bin/
COPY crates/sidecar/fonts/ /usr/local/share/fonts/bdf/
ENV DISPLAY_NUMBER=99
CMD ["x11-web-sidecar"]
