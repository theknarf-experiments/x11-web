# Backend env vars. Copy to `.env` and source it before running
# `cargo run -p x11-web-backend` (or pass through your runner).
#
# OIDC is fully optional — leaving `OIDC_ISSUER` unset keeps the
# backend in anonymous-only mode. To turn it on, point it at any
# OAuth2/OIDC-compatible provider that publishes a
# `.well-known/openid-configuration` discovery document. The
# committed `compose.dev.yml` runs a `mock-oauth2-server` that
# matches the values below for local dev / e2e tests.

OIDC_ISSUER=http://localhost:8080/x11-web
OIDC_CLIENT_ID=x11-web
# Empty when using public-client / PKCE-only flows. Set this
# (and use a confidential client config in your IdP) for real
# deployments where the browser shouldn't be trusted to hold a
# secret.
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
# Where the user lands after a successful callback. In dev with
# Vite this is the dev server (different port from the backend);
# in production where the backend serves the static SPA, leave
# the default `/`.
OIDC_POST_LOGIN_REDIRECT=http://localhost:5173/
