# Backend env vars. Copy to `.env` and source it before running
# `cargo run -p x11-web-backend` (or pass through your runner).
#
# OIDC is fully optional — leaving `OIDC_ISSUER` unset keeps the
# backend in anonymous-only mode. To turn it on, point it at any
# OAuth2/OIDC-compatible provider that publishes a
# `.well-known/openid-configuration` discovery document. The
# committed `compose.dev.yml` runs a `mock-oauth2-server` that
# matches the values below for local dev / e2e tests.

OIDC_ISSUER=http://localhost:8080/x11-web
OIDC_CLIENT_ID=x11-web
# Empty when using public-client / PKCE-only flows. Set this
# (and use a confidential client config in your IdP) for real
# deployments where the browser shouldn't be trusted to hold a
# secret.
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
# Where the user lands after a successful callback. In dev with
# Vite this is the dev server (different port from the backend);
# in production where the backend serves the static SPA, leave
# the default `/`.
OIDC_POST_LOGIN_REDIRECT=http://localhost:5173/

# OpenTelemetry — point at any OTLP gRPC endpoint to enable
# traces + metrics + logs. The committed `compose.dev.yml` runs
# OpenObserve (single binary, all three pillars in one UI) on
# :5080 (UI) + :5081 (gRPC OTLP). Leave
# `OTEL_EXPORTER_OTLP_ENDPOINT` unset to disable telemetry
# entirely (no SDK init, no overhead).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5081/api/default
# OpenObserve auth via gRPC metadata. Token below is
# base64(admin@admin.com:admin) — the dev creds set on the
# OpenObserve container in compose.dev.yml.
OTEL_EXPORTER_OTLP_HEADERS=authorization=Basic YWRtaW5AYWRtaW4uY29tOmFkbWlu,organization=default,stream-name=default
OTEL_SERVICE_NAME=x11-web-backend

# `o2` CLI (packages/o2-cli) — same OpenObserve instance, but
# talks to the HTTP API on :5080 (not the OTLP port). All four
# vars have defaults matching compose.dev.yml; override only if
# you point the CLI at a different OpenObserve.
O2_ENDPOINT=http://localhost:5080
O2_ORG=default
O2_EMAIL=admin@admin.com
O2_PASSWORD=admin
