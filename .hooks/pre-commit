#!/usr/bin/env bash
# Pre-commit hook: format-check + typecheck every TS workspace
# before letting the commit through.
#
# Activated repo-wide via `mise run install-hooks` (one-shot,
# per clone — sets `core.hooksPath` to `.hooks/`).
#
# `turbo run typecheck` fans out to every package's `typecheck`
# script and short-circuits on the first failure. Turbo caches
# results keyed on input file hashes so the hook is effectively
# free on commits that don't touch typed code.

set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

# Formatting check (no writes) — fails if any file diverges from
# biome's formatting; fix with `pnpm format`. Runs first since it
# finishes in milliseconds.
pnpm exec biome format .

# Use `pnpm exec` so the locally-installed `turbo` is on PATH
# regardless of the dev's global setup.
pnpm exec turbo run typecheck
