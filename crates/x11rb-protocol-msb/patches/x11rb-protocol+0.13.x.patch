+/// Endian-aware variant of [`parse_list`]. Used by the generator when it
+/// emits the `TryParseEndian` body for a list-typed field.
+#[allow(dead_code)]
+pub(crate) fn parse_list_endian<T>(
+    data: &[u8],
+    list_length: usize,
+    endian: ByteOrder,
+) -> Result<(Vec<T>, &[u8]), ParseError>
+where
+    T: TryParseEndian,
+{
+    let mut remaining = data;
+    let mut result = Vec::with_capacity(list_length);
+    for _ in 0..list_length {
+        let (entry, new_remaining) = T::try_parse_endian(remaining, endian)?;
+        result.push(entry);
+        remaining = new_remaining;
+    }
     Ok((result, remaining))
 }
 
