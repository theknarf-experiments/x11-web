+/// Wire byte order, used when an X11 server has to parse / serialise on
+/// behalf of a specific client. Upstream's `TryParse` / `Serialize` are
+/// hard-coded to host-native endianness (LSB on x86/ARM) because x11rb is
+/// a client library that always controls both ends; this enum + the
+/// `TryParseEndian` / `SerializeEndian` traits below extend the framework
+/// so a server can speak either order without re-emitting hand-coded
+/// byte-swappers per request.
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub enum ByteOrder {
+    /// Least-significant-byte-first (little-endian).
+    Lsb,
+    /// Most-significant-byte-first (big-endian).
+    Msb,
+}
+
+impl ByteOrder {
+    /// `ByteOrder::Lsb` on little-endian hosts, `ByteOrder::Msb` on
+    /// big-endian hosts. Matches what plain `TryParse` / `Serialize` use.
+    pub const NATIVE: ByteOrder = if cfg!(target_endian = "little") {
+        ByteOrder::Lsb
+    } else {
+        ByteOrder::Msb
+    };
+}
+
+/// A type implementing this trait can be parsed from raw bytes in a
+/// caller-chosen byte order. Implementations are generated alongside the
+/// host-endian `TryParse` impls.
+pub trait TryParseEndian: Sized {
+    /// Parse `value` with the given byte order, returning the parsed value
+    /// plus the remaining bytes.
+    fn try_parse_endian(value: &[u8], endian: ByteOrder) -> Result<(Self, &[u8]), ParseError>;
+}
+
+/// A type implementing this trait can be serialised into raw bytes in a
+/// caller-chosen byte order.
+pub trait SerializeEndian {
+    /// Serialise this value into a fresh `Vec<u8>` in the given byte order.
+    fn serialize_endian(&self, endian: ByteOrder) -> Vec<u8> {
+        let mut bytes = Vec::new();
+        self.serialize_endian_into(&mut bytes, endian);
+        bytes
+    }
+    /// Serialise this value, appending into the given `Vec<u8>`.
+    fn serialize_endian_into(&self, bytes: &mut Vec<u8>, endian: ByteOrder);
+}
+
