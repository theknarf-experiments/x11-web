+// --- endian-aware versions of the primitive impls -------------------------
+
+macro_rules! implement_try_parse_endian {
+    ($t:ty) => {
+        impl TryParseEndian for $t {
+            fn try_parse_endian(
+                value: &[u8],
+                endian: ByteOrder,
+            ) -> Result<(Self, &[u8]), ParseError> {
+                let len = core::mem::size_of::<$t>();
+                let bytes: [u8; core::mem::size_of::<$t>()] = value
+                    .get(..len)
+                    .ok_or(ParseError::InsufficientData)?
+                    .try_into()
+                    .unwrap();
+                let v = match endian {
+                    ByteOrder::Lsb => <$t>::from_le_bytes(bytes),
+                    ByteOrder::Msb => <$t>::from_be_bytes(bytes),
+                };
+                Ok((v, &value[len..]))
+            }
+        }
+    };
+}
+
+macro_rules! implement_serialize_endian {
+    ($t:ty) => {
+        impl SerializeEndian for $t {
+            fn serialize_endian_into(&self, bytes: &mut Vec<u8>, endian: ByteOrder) {
+                match endian {
+                    ByteOrder::Lsb => bytes.extend_from_slice(&self.to_le_bytes()),
+                    ByteOrder::Msb => bytes.extend_from_slice(&self.to_be_bytes()),
+                }
+            }
+        }
+    };
+}
+
+macro_rules! forward_float_endian {
+    ($from:ty: $to:ty) => {
+        impl TryParseEndian for $from {
+            fn try_parse_endian(
+                value: &[u8],
+                endian: ByteOrder,
+            ) -> Result<(Self, &[u8]), ParseError> {
+                let (data, remaining) = <$to>::try_parse_endian(value, endian)?;
+                Ok((<$from>::from_bits(data), remaining))
+            }
+        }
+        impl SerializeEndian for $from {
+            fn serialize_endian_into(&self, bytes: &mut Vec<u8>, endian: ByteOrder) {
+                self.to_bits().serialize_endian_into(bytes, endian);
+            }
+        }
+    };
+}
+
+implement_try_parse_endian!(u8);
+implement_try_parse_endian!(i8);
+implement_try_parse_endian!(u16);
+implement_try_parse_endian!(i16);
+implement_try_parse_endian!(u32);
+implement_try_parse_endian!(i32);
+implement_try_parse_endian!(u64);
+implement_try_parse_endian!(i64);
+
+implement_serialize_endian!(u8);
+implement_serialize_endian!(i8);
+implement_serialize_endian!(u16);
+implement_serialize_endian!(i16);
+implement_serialize_endian!(u32);
+implement_serialize_endian!(i32);
+implement_serialize_endian!(u64);
+implement_serialize_endian!(i64);
+
+forward_float_endian!(f32: u32);
+forward_float_endian!(f64: u64);
